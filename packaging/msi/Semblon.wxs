<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semblon code MSI (WiX v4/v5).
  NEVER bundle buffalo_l / InsightFace weights — redistribution UNAVAILABLE
  until a pack licence exists (docs/licenses.md).

  Build on Windows: tools\msi\build-msi.ps1
  PayloadComponents.wxs is generated from the staged payload (no weights).

  Install layout:
    Code:  %LOCALAPPDATA%\Programs\Semblon
    Store: %LOCALAPPDATA%\Semblon   (NOT removed by MSI uninstall)

  First launch bootstraps .venv via tools\msi\bootstrap-install.ps1 when the
  .semblon-msi-install marker is present (no WiX Util extension required).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Semblon"
      Manufacturer="Semblon"
      Version="$(var.ProductVersion)"
      UpgradeCode="b7988316-a8a8-5fd9-84e0-e4633ccbff43"
      Scope="perUser"
      Language="1033">

    <SummaryInformation
        Description="Semblon local face intelligence (code install; no model weights)"
        Manufacturer="Semblon" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Semblon is already installed. Uninstall it first." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Per-user code root. Store is separate: %LOCALAPPDATA%\Semblon -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Semblon" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Semblon" />
    </StandardDirectory>

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Perps12-oss/semblon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Code only. buffalo_l weights not redistributed. Store: %LOCALAPPDATA%\Semblon" />

    <Feature Id="ProductFeature" Title="Semblon" Description="Semblon application code (no weights)" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="InstallFolderRegistry" />
    </Feature>

    <Component Id="StartMenuShortcuts" Directory="ApplicationProgramsFolder" Guid="cd45c21d-8bb7-5617-b5ce-fdf2178aca5b">
      <Shortcut
          Id="SemblonHomeShortcut"
          Name="Semblon"
          Description="Open Semblon Home (code install; weights not bundled)"
          Target="[INSTALLFOLDER]semblon.cmd"
          WorkingDirectory="INSTALLFOLDER"
          Advertise="no" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Semblon\Installer"
          Name="StartMenuInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <Component Id="InstallFolderRegistry" Directory="INSTALLFOLDER" Guid="a7e3f0c1-4b2d-5e6f-8190-abcdefabcdef">
      <RegistryValue
          Root="HKCU"
          Key="Software\Semblon\Installer"
          Name="InstallFolder"
          Type="string"
          Value="[INSTALLFOLDER]"
          KeyPath="yes" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Semblon\Installer"
          Name="WeightsBundled"
          Type="string"
          Value="false" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Semblon\Installer"
          Name="StorePathHint"
          Type="string"
          Value="[LocalAppDataFolder]Semblon" />
    </Component>

  </Package>
</Wix>
